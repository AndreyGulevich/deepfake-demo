{
  "name": "deepfake-demo",
  "productName": "Deepfake Demo",
  "description": "Local SIP video and synthetic media test studio",
  "author": "Deepfake Demo contributors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "build:mac": "yarn build && electron-builder --mac dmg --publish never",
    "build:win": "yarn build && electron-builder --win nsis --publish never",
    "build:linux": "yarn build && electron-builder --linux AppImage --publish never",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@krivega/jssip": "8.0.4",
    "electron": "45.3.4",
    "electron-builder": "^26.0.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sip-connector": "31.3.9",
    "ua-parser-js": "1.0.41",
    "vite": "^7.2.2"
  },
  "build": {
    "appId": "studio.deepfakedemo.desktop",
    "directories": {"output":"release"},
    "files": ["dist/**/*","electron/**/*","package.json"],
    "mac": {"target":"dmg","identity":null,"extendInfo":{"NSCameraUsageDescription":"Камера для исходящего видеозвонка","NSMicrophoneUsageDescription":"Микрофон для звука конференции"}},
    "win": {"target":"nsis"},
    "linux": {"target":"AppImage","category":"AudioVideo"}
  }
}
