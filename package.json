{
  "name": "deepfake-demo",
  "productName": "Deepfake Demo",
  "description": "Local SIP video and synthetic media test studio",
  "author": "Deepfake Demo contributors",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:electron": "yarn build && electron .",
    "dev:web": "vite",
    "build": "vite build",
    "build:mac": "yarn build && electron-builder --mac dmg --publish never",
    "build:win": "yarn build && electron-builder --win nsis --publish never",
    "build:linux": "yarn build && electron-builder --linux AppImage --publish never",
    "test": "node --test test/*.test.mjs src/detectors/classifier/pico/tracker.test.mjs",
    "model:mtl": "node src/detectors/mtl/prepare.mjs",
    "model:detector": "node src/detectors/classifier/prepare.mjs",
    "setup:deepfacelive": "node scripts/deepfacelive.mjs setup",
    "start:deepfacelive": "node scripts/deepfacelive.mjs start",
    "start:deeplivecam": "node scripts/deeplivecam.mjs",
    "start:liveportrait": "node scripts/liveportrait.mjs",
    "start:hyperswap": "node scripts/hyperswap.mjs",
    "start:hififace": "node scripts/hififace.mjs",
    "start:ghostv2": "node scripts/ghostv2.mjs",
    "start:ftcn": "node scripts/ftcn.mjs",
    "start:altfreezing": "node scripts/local-detector.mjs altfreezing",
    "start:sbi": "node scripts/local-detector.mjs sbi"
  },
  "devDependencies": {
    "@krivega/jssip": "8.0.4",
    "electron": "45.3.4",
    "electron-builder": "^26.0.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sip-connector": "31.3.9",
    "ua-parser-js": "1.0.41",
    "vite": "^7.2.2",
    "onnxruntime-web": "1.22.0"
  },
  "build": {
    "appId": "studio.deepfakedemo.desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "Камера для исходящего видеозвонка",
        "NSMicrophoneUsageDescription": "Микрофон для звука конференции"
      }
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    },
    "extraResources": [
      {
        "from": "integrations/deepfacelive",
        "to": "deepfacelive",
        "filter": [
          "server.py",
          "runtime.py",
          "prepare.py",
          "requirements.txt",
          "MODEL.md"
        ]
      },
      {
        "from": "integrations/deeplivecam",
        "to": "deeplivecam",
        "filter": [
          "server.py",
          "dlc_engine.py",
          "README.md",
          "TERMS.md",
          "INSTALL.md",
          "requirements.txt",
          "prepare_models.py"
        ]
      },
      {
        "from": "integrations/ftcn",
        "to": "ftcn",
        "filter": [
          "*.py",
          "requirements.txt",
          "README.md"
        ]
      }
    ]
  }
}
